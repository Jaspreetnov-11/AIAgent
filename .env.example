# ---- Prompt writer (free path) ----
# Free key from https://aistudio.google.com/apikey (no card).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# gemini | anthropic. Empty = auto: Gemini if its key exists, else Claude.
LLM_PROVIDER=

# ---- Optional: Claude instead of Gemini (paid per token) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# ---- Integration (optional) ----
# If set, every POST to /api/* must send header  x-api-key: <this value>.
STUDIO_API_KEY=
# Comma-separated browser origins allowed to call the API directly. Empty = any.
ALLOWED_ORIGINS=
