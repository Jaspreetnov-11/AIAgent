ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Claude = art director + critic. Opus 5 is the default; effort low|medium|high|xhigh|max.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# GPT Image = renderer. flare = fast default, sunburst = premium / edit-heavy.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Hard caps the API will refuse to exceed (cost guard).
AGENT_MAX_ROUNDS=4
AGENT_MAX_CANDIDATES=3

# 1 = placeholder images, no API calls. Also automatic whenever either key above is missing.
AGENT_MOCK=0
